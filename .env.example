# ============================================================
# Artisite Prospector v4 — Configuration Vercel & Production
# ============================================================

# SUR VERCEL :
# Aucun PORT à renseigner ! Vercel gère le routage et le port automatiquement.
# Ajoutez GEMINI_API_KEY. Les réglages de sécurité ci-dessous possèdent des valeurs sûres par défaut.

# Clé API Google Gemini pour la génération assistée par IA
# Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=

# Optionnel : Ordre des modèles pour le système de fallback automatique
# L'API tentera le premier modèle, et basculera immédiatement sur le suivant en cas de quota/erreur
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-8b

# Origines supplémentaires autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# L'origine de la requête est aussi acceptée lorsqu'elle correspond exactement au Host servi.
ALLOWED_ORIGINS=

# Budget par adresse IP pour les routes IA payantes, sur une fenêtre en millisecondes.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000

# (Uniquement pour le développement local ou Railway/Docker) :
PORT=5173
