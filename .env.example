# ============================================================
# Artisite Prospector v4 — Configuration Railway & Production
# ============================================================

# Port d'écoute du serveur HTTP (fourni automatiquement par Railway)
PORT=5173

# Clé API Google Gemini pour la génération assistée par IA
# Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=

# Ordre des modèles pour le système de fallback automatique
# L'API tentera le premier modèle, et basculera immédiatement sur le suivant en cas d'erreur ou de quota
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-8b
